{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Kordio",
  "colors": {
    "primary": "#0e7c74",
    "light": "#2fa79e",
    "dark": "#0a5f5a"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#fafbfb",
      "dark": "#0b0f0e"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "appearance": {
    "default": "system"
  },
  "thumbnails": {
    "appearance": "light"
  },
  "seo": {
    "metatags": {
      "og:type": "website",
      "og:site_name": "Kordio Documentation",
      "og:image": "https://docs.kordio.io/images/og.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.kordio.io/images/og.png"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "kordio.io",
        "href": "https://kordio.io"
      },
      {
        "label": "Support",
        "href": "mailto:support@kordio.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.kordio.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/trykordio/"
    }
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/ledger/quickstart" },
    { "source": "/concepts", "destination": "/ledger/concepts" },
    { "source": "/money-flows", "destination": "/ledger/money-flows" },
    { "source": "/reconciliation", "destination": "/ledger/reconciliation" },
    { "source": "/feeds", "destination": "/ledger/feeds" },
    { "source": "/pagination", "destination": "/ledger/pagination" },
    { "source": "/invariants", "destination": "/ledger/invariants" },
    { "source": "/why-not-postgres", "destination": "/ledger/why-not-postgres" },
    { "source": "/authentication", "destination": "/ledger/authentication" },
    { "source": "/errors", "destination": "/ledger/errors" },
    { "source": "/webhooks", "destination": "/ledger/webhooks" },
    { "source": "/api-reference/introduction", "destination": "/ledger/api-reference/introduction" },
    { "source": "/agents/api", "destination": "/agents/api-reference/introduction" }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "compass",
        "pages": [
          "index",
          "positioning",
          "changelog"
        ]
      },
      {
        "tab": "Spend control",
        "icon": "shield-check",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "agents/index",
              "agents/quickstart",
              "agents/authentication",
              "agents/why"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "agents/concepts",
              "agents/policies",
              "agents/spend-tokens",
              "agents/approvals",
              "agents/cosignatures"
            ]
          },
          {
            "group": "Guarantees",
            "pages": [
              "agents/guarantees",
              "agents/ledger-projection"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "agents/errors",
              "agents/webhooks",
              "agents/api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "agents/api-reference/openapi.yaml"
          }
        ]
      },
      {
        "tab": "Ledger",
        "icon": "book-open",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "ledger/index",
              "ledger/quickstart",
              "ledger/authentication",
              "ledger/why"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "ledger/concepts",
              "ledger/money-flows",
              "ledger/reconciliation",
              "ledger/feeds",
              "ledger/pagination"
            ]
          },
          {
            "group": "Guarantees",
            "pages": [
              "ledger/invariants",
              "ledger/why-not-postgres"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "ledger/errors",
              "ledger/webhooks",
              "ledger/api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "ledger/api-reference/openapi.yaml"
          }
        ]
      }
    ]
  }
}
